  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent       Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[]  @relation("DepartmentHierarchy")
  memberships  Membership[]
  services     Service[]
  encounters   Encounter[]
  queues       Queue[]

  patientJourneySteps        PatientJourneyStep[]
  handoffsFrom               PatientJourneyHandoff[]     @relation("HandoffFromDepartment")
  handoffsTo                 PatientJourneyHandoff[]     @relation("HandoffToDepartment")
  queueCareRecords           QueueCareRecord[]
  appointments               Appointment[]
  availabilityRules          ProviderAvailability[]
  availabilityBlocks         AvailabilityBlock[]
  staffProfiles              StaffProfile[]
  staffDepartmentAssignments StaffDepartmentAssignment[]
  staffShifts                StaffShift[]
  departmentAccessAttempts   DepartmentAccessAttempt[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([parentId])
  @@index([status])
  @@map("departments")
}

