model PatientJourney {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  patientTenantRecordId String  @db.Uuid
  encounterId           String? @db.Uuid

  status PatientJourneyStatus @default(ACTIVE)

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  encounter           Encounter?          @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  steps    PatientJourneyStep[]
  handoffs PatientJourneyHandoff[]

  @@index([tenantId, status])
  @@index([tenantId, patientTenantRecordId, status])
  @@index([tenantId, encounterId])
  @@map("patient_journeys")
}

model PatientJourneyHandoff {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  journeyId   String  @db.Uuid
  encounterId String? @db.Uuid

  fromStepId String? @db.Uuid
  toStepId   String? @db.Uuid

  fromBranchId     String? @db.Uuid
  fromDepartmentId String? @db.Uuid
  toBranchId       String? @db.Uuid
  toDepartmentId   String? @db.Uuid

  status PatientJourneyHandoffStatus @default(PENDING)

  reason      String? @db.VarChar(1000)
  instruction String? @db.VarChar(1000)

  initiatedByUserId String @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)
  rejectedAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journey   PatientJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  encounter Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  fromStep PatientJourneyStep? @relation("HandoffFromStep", fields: [fromStepId], references: [id], onDelete: Restrict)
  toStep   PatientJourneyStep? @relation("HandoffToStep", fields: [toStepId], references: [id], onDelete: Restrict)

  fromBranch Branch? @relation("HandoffFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch? @relation("HandoffToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  fromDepartment Department? @relation("HandoffFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartment   Department? @relation("HandoffToDepartment", fields: [toDepartmentId], references: [id], onDelete: Restrict)

  initiatedByUser User @relation("PatientJourneyHandoffInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, journeyId, status])
  @@index([tenantId, encounterId])
  @@index([tenantId, fromDepartmentId, status])
  @@index([tenantId, toDepartmentId, status])
  @@index([tenantId, initiatedByUserId])
  @@map("patient_journey_handoffs")
}

model PatientJourneyStep {
  id        String @id @default(uuid()) @db.Uuid
  journeyId String @db.Uuid
  tenantId  String @db.Uuid

  sequence Int
  type     PatientJourneyStepType
  status   PatientJourneyStepStatus @default(PENDING)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(1000)

  branchId     String? @db.Uuid
  departmentId String? @db.Uuid
  encounterId  String? @db.Uuid
  queueId      String? @db.Uuid
  queueEntryId String? @db.Uuid

  location    String? @db.VarChar(300)
  instruction String? @db.VarChar(1000)

  estimatedWaitMinutes     Int?
  estimatedDurationMinutes Int?

  readyAt     DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  journey      PatientJourney          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  handoffsFrom PatientJourneyHandoff[] @relation("HandoffFromStep")
  handoffsTo   PatientJourneyHandoff[] @relation("HandoffToStep")
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  encounter    Encounter?              @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  queue        Queue?                  @relation(fields: [queueId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry?             @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)

  @@unique([journeyId, sequence])
  @@index([tenantId, status])
  @@index([tenantId, journeyId, sequence])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, queueEntryId])
  @@map("patient_journey_steps")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  username    String?      @unique @db.VarChar(100)
  displayName String       @db.VarChar(200)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  identities                         Identity[]
  memberships                        Membership[]
  platformRoleAssignments            PlatformRoleAssignment[]
  sessions                           Session[]
  devices                            Device[]
  apiKeys                            ApiKey[]
  patientProfile                     PatientProfile?
  registrations                      Registration[]
  registrationSessions               RegistrationSession[]
  verificationChallenges             VerificationChallenge[]
  auditEvents                        AuditEvent[]                       @relation("AuditActor")
  securityEvents                     SecurityEvent[]                    @relation("SecurityActor")
  createdPatientRecords              PatientTenantRecord[]              @relation("PatientRecordCreator")
  patientDataSubmissions             PatientDataSubmission[]            @relation("PatientDataSubmitter")
  providerProfiles                   ProviderProfile[]
  encountersCreated                  Encounter[]                        @relation("EncounterCreator")
  encountersStatusChanged            EncounterStatusHistory[]           @relation("EncounterStatusChanger")
  patientAccessRequestsMade          PatientAccessRequest[]             @relation("PatientAccessRequestor")
  patientAccessRequestsReviewed      PatientAccessRequest[]             @relation("PatientAccessRequestReviewer")
  patientAccessGrantsCreated         PatientAccessGrant[]               @relation("PatientAccessGrantCreator")
  patientAccessLogs                  PatientDataAccessLog[]
  patientRelationshipRequestsMade    PatientTenantRelationshipRequest[] @relation("PatientRelationshipRequestor")
  patientRelationshipRequestsHandled PatientTenantRelationshipRequest[] @relation("PatientRelationshipRequestResponder")
  familyRelationshipRequestsMade     PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipRequestCreator")
  familyRelationshipRequestsHandled  PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipRequestResponder")
  familyRelationshipsRequested       PatientFamilyRelationship[]        @relation("FamilyRelationshipRequesterUser")
  familyRelationshipsApproved        PatientFamilyRelationship[]        @relation("FamilyRelationshipApproverUser")
  familyRelationshipsCreated         PatientFamilyRelationship[]        @relation("FamilyRelationshipCreator")
  familyRelationshipsRevoked         PatientFamilyRelationship[]        @relation("FamilyRelationshipRevoker")
  patientJourneyHandoffsInitiated    PatientJourneyHandoff[]            @relation("PatientJourneyHandoffInitiator")

  guardianAuthoritiesCreated            PatientGuardianAuthority[]            @relation("GuardianAuthorityCreator")
  guardianAuthoritiesVerified           PatientGuardianAuthority[]            @relation("GuardianAuthorityVerifier")
  guardianAuthoritiesRevoked            PatientGuardianAuthority[]            @relation("GuardianAuthorityRevoker")
  guardianVerificationDocumentsUploaded PatientGuardianVerificationDocument[] @relation("GuardianVerificationDocumentUploader")
  guardianVerificationDocumentsReviewed PatientGuardianVerificationDocument[] @relation("GuardianVerificationDocumentReviewer")
  dependentRegistrationsCreated         PatientDependentRegistration[]        @relation("DependentRegistrationCreator")
  dependentRegistrationsReviewed        PatientDependentRegistration[]        @relation("DependentRegistrationReviewer")
  familyAccessGrantsCreated             FamilyAccessGrant[]                   @relation("FamilyAccessGrantCreator")
  familyAccessGrantsRevoked             FamilyAccessGrant[]                   @relation("FamilyAccessGrantRevoker")
  familyVerificationDocumentsUploaded   FamilyVerificationDocument[]          @relation("FamilyVerificationDocumentUploader")
  familyVerificationDocumentsReviewed   FamilyVerificationDocument[]          @relation("FamilyVerificationDocumentReviewer")

  clinicalNotesAuthored       ClinicalNote[]        @relation("ClinicalNoteAuthor")
  clinicalNoteVersionsCreated ClinicalNoteVersion[] @relation("ClinicalNoteVersionCreator")

  patientDeletionRequestsMade     PatientDeletionRequest[] @relation("PatientDeletionRequester")
  patientDeletionRequestsReviewed PatientDeletionRequest[] @relation("PatientDeletionReviewer")

  patientContactRecordsCreated    PatientContact[]          @relation("PatientContactCreator")
  patientContactRecordsUpdated    PatientContact[]          @relation("PatientContactUpdater")
  emergencyContactsCreated        EmergencyContact[]        @relation("EmergencyContactCreator")
  emergencyContactsUpdated        EmergencyContact[]        @relation("EmergencyContactUpdater")
  nextOfKinRecordsCreated         NextOfKin[]               @relation("NextOfKinCreator")
  nextOfKinRecordsUpdated         NextOfKin[]               @relation("NextOfKinUpdater")
  patientAddressesCreated         PatientAddress[]          @relation("PatientAddressCreator")
  patientAddressesUpdated         PatientAddress[]          @relation("PatientAddressUpdater")
  patientInsurancesCreated        PatientInsurance[]        @relation("PatientInsuranceCreator")
  patientInsurancesUpdated        PatientInsurance[]        @relation("PatientInsuranceUpdater")
  patientCorporateProfilesCreated PatientCorporateProfile[] @relation("PatientCorporateProfileCreator")
  patientCorporateProfilesUpdated PatientCorporateProfile[] @relation("PatientCorporateProfileUpdater")
  createdQueueEntries             QueueEntry[]              @relation("QueueEntryCreator")
  queueEntryHistoryChanges        QueueEntryHistory[]       @relation("QueueEntryHistoryChanger")
  queueCallsMade                  QueueCall[]               @relation("QueueCallCaller")
  queueCareRecordsAuthored        QueueCareRecord[]         @relation("QueueCareRecordAuthor")
  queueCareAttachmentsUploaded    QueueCareAttachment[]     @relation("QueueCareAttachmentUploader")

  notifications             Notification[]
  webPushSubscriptions      WebPushSubscription[]
  appointmentsCreated       Appointment[]               @relation("AppointmentCreator")
  appointmentStatusChanges  AppointmentStatusHistory[]  @relation("AppointmentStatusChanger")
  availabilityRulesCreated  ProviderAvailability[]      @relation("ProviderAvailabilityCreator")
  availabilityBlocksCreated AvailabilityBlock[]         @relation("AvailabilityBlockCreator")
  staffProfiles             StaffProfile[]
  departmentAccessAttempts  DepartmentAccessAttempt[]
  staffAssignmentsAssigned  StaffDepartmentAssignment[] @relation("StaffAssignmentAssigner")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model Identity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  type            IdentityType
  value           String       @db.VarChar(320)
  normalizedValue String       @db.VarChar(320)
  credentialHash  String?      @db.VarChar(512)
  verifiedAt      DateTime?    @db.Timestamptz(6)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, normalizedValue])
  @@index([userId])
  @@index([type, normalizedValue])
  @@map("identities")
}

model ProviderProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  userId             String       @db.Uuid
  providerNumber     String       @db.VarChar(100)
  providerType       ProviderType
  professionalTitle  String?      @db.VarChar(150)
  specialty          String?      @db.VarChar(200)
  subspecialty       String?      @db.VarChar(200)
  registrationNumber String?      @db.VarChar(150)
  registrationBody   String?      @db.VarChar(200)
  licenseNumber      String?      @db.VarChar(150)
  licenseExpiryDate  DateTime?    @db.Date
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?    @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  encounters            Encounter[]
  clinicalNotesAuthored ClinicalNote[]         @relation("ClinicalNoteProviderAuthor")
  appointments          Appointment[]
  availabilityRules     ProviderAvailability[]
  availabilityBlocks    AvailabilityBlock[]

  @@unique([tenantId, userId])
  @@unique([tenantId, providerNumber])
  @@index([tenantId, status])
  @@index([tenantId, providerType])
  @@index([userId, status])
  @@index([tenantId, specialty])
  @@map("provider_profiles")
}

enum ClinicalNoteType {
  CONSULTATION
  PROGRESS
  EMERGENCY
  ADMISSION
  DISCHARGE
  PROCEDURE
  FOLLOW_UP
  TELEMEDICINE
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
  FINAL
  AMENDED
  VOID
}

enum QueueStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QueueEntryStatus {
  CREATED
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
  CANCELLED
  NO_SHOW
}

enum QueueEntryPriority {
  ROUTINE
  URGENT
  PRIORITY
  EMERGENCY
}

model Queue {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  branchId     String? @db.Uuid
  departmentId String? @db.Uuid

  name        String  @db.VarChar(200)
  code        String  @db.VarChar(50)
  description String? @db.VarChar(1000)

  status QueueStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  entries QueueEntry[]

  patientJourneySteps PatientJourneyStep[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, departmentId, status])
  @@map("queues")
}

model QueueEntry {
  id                    String @id @default(uuid()) @db.Uuid
  tenantId              String @db.Uuid
  queueId               String @db.Uuid
  encounterId           String @db.Uuid
  patientTenantRecordId String @db.Uuid

  queueNumber String             @db.VarChar(100)
  priority    QueueEntryPriority @default(ROUTINE)
  status      QueueEntryStatus   @default(CREATED)

  position Int?
  reason   String? @db.VarChar(1000)

  checkedInAt DateTime? @db.Timestamptz(6)
  calledAt    DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  skippedAt   DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)
  noShowAt    DateTime? @db.Timestamptz(6)

  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  queue               Queue               @relation(fields: [queueId], references: [id], onDelete: Restrict)
  encounter           Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  createdByUser       User                @relation("QueueEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  history     QueueEntryHistory[]
  calls       QueueCall[]
  careRecords QueueCareRecord[]

  journeySteps PatientJourneyStep[]

  @@unique([tenantId, queueId, queueNumber])
  @@index([tenantId, queueId, status])
  @@index([tenantId, queueId, priority, status])
  @@index([tenantId, encounterId])
  @@index([tenantId, patientTenantRecordId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("queue_entries")
}

model QueueCareRecord {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  queueEntryId String  @db.Uuid
  encounterId  String  @db.Uuid
  departmentId String? @db.Uuid
  authorUserId String  @db.Uuid

  note        String? @db.Text
  procedures  String? @db.Text
  documentUrl String? @db.VarChar(2048)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  queueEntry  QueueEntry            @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  encounter   Encounter             @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  department  Department?           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  author      User                  @relation("QueueCareRecordAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
