model PatientProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  platformPatientId String    @unique @default(cuid()) @db.VarChar(50)
  firstName         String    @db.VarChar(100)
  secondName        String    @db.VarChar(100)
  dateOfBirth       DateTime? @db.Date
  location          String?   @db.VarChar(300)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user                               User                               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenantRecords                      PatientTenantRecord[]
  dataSubmissions                    PatientDataSubmission[]
  accessRequests                     PatientAccessRequest[]
  accessGrants                       PatientAccessGrant[]
  accessLogs                         PatientDataAccessLog[]
  deletionRequests                   PatientDeletionRequest[]
  relationshipRequests               PatientTenantRelationshipRequest[]
  familyRelationshipsInitiated       PatientFamilyRelationship[]        @relation("FamilyRelationshipSubject")
  familyRelationshipsReceived        PatientFamilyRelationship[]        @relation("FamilyRelationshipRelated")
  familyRelationshipRequestsMade     PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipRequester")
  familyRelationshipRequestsReceived PatientFamilyRelationshipRequest[] @relation("FamilyRelationshipTarget")
  familyAccessGrantsAsPatient        FamilyAccessGrant[]                @relation("FamilyAccessGrantPatient")
  familyAccessGrantsAsDelegate       FamilyAccessGrant[]                @relation("FamilyAccessGrantDelegate")
  familyVerificationDocuments        FamilyVerificationDocument[]       @relation("FamilyVerificationDocumentOwner")

  guardianAuthoritiesGranted               PatientGuardianAuthority[]            @relation("GuardianAuthorityGuardian")
  guardianAuthoritiesReceived              PatientGuardianAuthority[]            @relation("GuardianAuthorityDependent")
  guardianVerificationDocumentsAsGuardian  PatientGuardianVerificationDocument[] @relation("GuardianVerificationDocumentGuardian")
  guardianVerificationDocumentsAsDependent PatientGuardianVerificationDocument[] @relation("GuardianVerificationDocumentDependent")

  dependentRegistration             PatientDependentRegistration?  @relation("DependentRegistrationDependent")
  dependentRegistrationsCreated     PatientDependentRegistration[] @relation("DependentRegistrationRegistrar")
  familyAccessAuditEventsAsPatient  FamilyAccessAuditLog[]         @relation("FamilyAccessAuditPatient")
  familyAccessAuditEventsAsDelegate FamilyAccessAuditLog[]         @relation("FamilyAccessAuditDelegate")

  contact           PatientContact?
  emergencyContacts EmergencyContact[]
  nextOfKin         NextOfKin[]
  addresses         PatientAddress[]
  insurances        PatientInsurance[]
  corporateProfile  PatientCorporateProfile?

  @@index([firstName, secondName])
  @@index([location])
  @@map("patient_profiles")
}

model PatientGuardianAuthority {
  id                        String                            @id @default(uuid()) @db.Uuid
  guardianPatientProfileId  String                            @db.Uuid
  dependentPatientProfileId String                            @db.Uuid
  authorityType             PatientGuardianAuthorityType
  status                    PatientGuardianAuthorityStatus    @default(ACTIVE)
  verificationStatus        PatientGuardianVerificationStatus @default(PENDING)

  createdByUserId  String  @db.Uuid
  verifiedByUserId String? @db.Uuid
  revokedByUserId  String? @db.Uuid

  startsAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime? @db.Timestamptz(6)
  verifiedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  reason             String? @db.VarChar(1000)
  verificationReason String? @db.VarChar(1000)
  revokedReason      String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  guardianPatientProfile  PatientProfile @relation("GuardianAuthorityGuardian", fields: [guardianPatientProfileId], references: [id], onDelete: Restrict)
  dependentPatientProfile PatientProfile @relation("GuardianAuthorityDependent", fields: [dependentPatientProfileId], references: [id], onDelete: Restrict)

  createdByUser         User                                  @relation("GuardianAuthorityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  verifiedByUser        User?                                 @relation("GuardianAuthorityVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  revokedByUser         User?                                 @relation("GuardianAuthorityRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  verificationDocuments PatientGuardianVerificationDocument[]

  @@index([guardianPatientProfileId, status])
  @@index([dependentPatientProfileId, status])
  @@index([verificationStatus])
  @@index([expiresAt])
  @@index([createdByUserId, createdAt])
  @@map("patient_guardian_authorities")
}

model PatientGuardianVerificationDocument {
  id                        String @id @default(uuid()) @db.Uuid
  guardianAuthorityId       String @db.Uuid
  guardianPatientProfileId  String @db.Uuid
  dependentPatientProfileId String @db.Uuid

  type   PatientGuardianVerificationDocumentType
  status PatientGuardianVerificationDocumentStatus @default(UPLOADED)

  storageKey    String? @db.VarChar(1000)
  fileName      String  @db.VarChar(255)
  mimeType      String  @db.VarChar(150)
  fileSizeBytes BigInt
  checksum      String  @db.VarChar(128)

  uploadedByUserId String  @db.Uuid
  reviewedByUserId String? @db.Uuid

  reviewedAt      DateTime? @db.Timestamptz(6)
  rejectionReason String?   @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  guardianAuthority       PatientGuardianAuthority @relation(fields: [guardianAuthorityId], references: [id], onDelete: Restrict)
  guardianPatientProfile  PatientProfile           @relation("GuardianVerificationDocumentGuardian", fields: [guardianPatientProfileId], references: [id], onDelete: Restrict)
  dependentPatientProfile PatientProfile           @relation("GuardianVerificationDocumentDependent", fields: [dependentPatientProfileId], references: [id], onDelete: Restrict)

  uploadedByUser User  @relation("GuardianVerificationDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser User? @relation("GuardianVerificationDocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([guardianAuthorityId, status])
  @@index([guardianPatientProfileId, status])
  @@index([dependentPatientProfileId, status])
  @@index([status, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@map("patient_guardian_verification_documents")
}

model PatientDependentRegistration {
