  completedAt DateTime? @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([type, status])
  @@index([verificationStatus])
  @@index([onboardingStatus])
  @@map("registrations")
}

model RegistrationSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("registration_sessions")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
  FAMILY_ACCESS
}

model VerificationChallenge {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  channel     VerificationChannel
  purpose     VerificationPurpose
  target      String              @db.VarChar(320)
  codeHash    String              @db.VarChar(128)
  expiresAt   DateTime            @db.Timestamptz(6)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  verifiedAt  DateTime?           @db.Timestamptz(6)
  consumedAt  DateTime?           @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, channel])
  @@index([target, purpose])
  @@index([expiresAt])
  @@map("verification_challenges")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Notification {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String? @db.Uuid
  recipientUserId String  @db.Uuid

  type  String @db.VarChar(150)
  title String @db.VarChar(300)
  body  String @db.VarChar(5000)
  data  Json?

  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipientUser User                   @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  deliveries    NotificationDelivery[]

  @@index([recipientUserId, readAt, createdAt])
  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  idempotencyKey String @unique @db.VarChar(300)
  attempts       Int    @default(0)

  availableAt   DateTime  @default(now()) @db.Timestamptz(6)
  processingAt  DateTime? @db.Timestamptz(6)
  sentAt        DateTime? @db.Timestamptz(6)
  failedAt      DateTime? @db.Timestamptz(6)
  failureReason String?   @db.VarChar(2000)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([notificationId, channel])
  @@index([channel, status, availableAt])
  @@map("notification_deliveries")
}

enum AppointmentStatus {
  REQUESTED
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REJECTED
}

enum AppointmentBookingSource {
  PATIENT_PORTAL
  STAFF
  PHONE
  WALK_IN
  INTEGRATION
}

model Appointment {
  id                    String                   @id @default(uuid()) @db.Uuid
  tenantId              String                   @db.Uuid
  patientTenantRecordId String                   @db.Uuid
  providerId            String?                  @db.Uuid
  branchId              String?                  @db.Uuid
  departmentId          String?                  @db.Uuid
  serviceId             String?                  @db.Uuid
  appointmentNumber     String                   @db.VarChar(100)
  status                AppointmentStatus        @default(REQUESTED)
  bookingSource         AppointmentBookingSource @default(PATIENT_PORTAL)
  startAt               DateTime                 @db.Timestamptz(6)
  endAt                 DateTime                 @db.Timestamptz(6)
  timeZone              String                   @db.VarChar(100)
  reason                String?                  @db.VarChar(1000)
  patientNotes          String?                  @db.VarChar(2000)
  staffNotes            String?                  @db.VarChar(2000)
  cancellationReason    String?                  @db.VarChar(1000)
  cancelledAt           DateTime?                @db.Timestamptz(6)
  checkedInAt           DateTime?                @db.Timestamptz(6)
  createdByUserId       String                   @db.Uuid
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)

  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord        @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  provider            ProviderProfile?           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch              Branch?                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department          Department?                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  service             Service?                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser       User                       @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  statusHistory       AppointmentStatusHistory[]
  encounter           Encounter?

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId, status, startAt])
  @@index([tenantId, providerId, startAt, endAt])
  @@index([tenantId, patientTenantRecordId, startAt])
  @@index([tenantId, branchId, startAt])
  @@index([tenantId, departmentId, startAt])
  @@index([tenantId, serviceId, startAt])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  appointmentId   String             @db.Uuid
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  reason          String?            @db.VarChar(1000)
  changedByUserId String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  changedByUser User        @relation("AppointmentStatusChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, appointmentId, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("appointment_status_history")
}

model ProviderAvailability {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  providerId      String    @db.Uuid
  branchId        String?   @db.Uuid
  departmentId    String?   @db.Uuid
  serviceId       String?   @db.Uuid
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int
  timeZone        String    @db.VarChar(100)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  slotDurationMin Int?
  isActive        Boolean   @default(true)
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser User            @relation("ProviderAvailabilityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, providerId, isActive, dayOfWeek])
  @@index([tenantId, branchId, isActive])
  @@index([tenantId, departmentId, isActive])
  @@index([tenantId, serviceId, isActive])
  @@map("provider_availability")
}

model AvailabilityBlock {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  providerId      String?  @db.Uuid
  branchId        String?  @db.Uuid
  departmentId    String?  @db.Uuid
  serviceId       String?  @db.Uuid
  startAt         DateTime @db.Timestamptz(6)
  endAt           DateTime @db.Timestamptz(6)
  reason          String?  @db.VarChar(1000)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider      ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser User             @relation("AvailabilityBlockCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, startAt, endAt])
  @@index([tenantId, providerId, startAt, endAt])
  @@index([tenantId, branchId, startAt, endAt])
  @@index([tenantId, departmentId, startAt, endAt])
  @@map("availability_blocks")
}
